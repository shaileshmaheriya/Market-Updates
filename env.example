# Claude API key — from console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram bot token — from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat ID — message @userinfobot on Telegram to get it
TELEGRAM_CHAT_ID=

# Instagram Business account ID (numeric) — found via Graph API Explorer
IG_USER_ID=

# Long-lived Instagram access token (Graph API, instagram_business_content_publish scope)
IG_ACCESS_TOKEN=

# Free API key from imgbb.com, used to host the generated post image publicly
IMGBB_API_KEY=

# Optional — how often (in hours) to check the news. Default 4.
RUN_INTERVAL_HOURS=4
